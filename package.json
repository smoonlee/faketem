{
  "name": "atem-sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "An independent, portable ATEM control-workflow sandbox.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors cyan,magenta \"npm run dev --workspace=@atem-sandbox/server\" \"npm run dev --workspace=@atem-sandbox/web\"",
    "build": "npm run build --workspace=@atem-sandbox/server && npm run build --workspace=@atem-sandbox/web",
    "build:server": "esbuild packages/server/src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.cjs",
    "build:desktop": "npm run build --workspace=@atem-sandbox/web && esbuild apps/desktop/src/main.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=apps/desktop/dist/main.cjs",
    "desktop": "npm run build:desktop && electron apps/desktop",
    "dist:desktop": "npm run build:desktop && electron-builder --config electron-builder.yml --publish never",
    "start": "npm run start --workspace=@atem-sandbox/server",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.1.1",
    "ws": "^8.22.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.2",
    "atem-connection": "3.9.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
